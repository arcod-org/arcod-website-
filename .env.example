# ── Copy to .env for local development (Prisma reads .env, not .env.local). NEVER commit real values. ──
# In production these come from apphosting.yaml (+ Cloud Secret Manager for secrets).

# Neon (Dashboard → Connect). Pooled URL for the app, direct URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/arcod?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/arcod?sslmode=require"

# Firebase web config (Project settings → Your apps → Web app). These are public identifiers, not secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="arcod-website.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="arcod-website"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="arcod-website.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Local dev only: path to a service-account key so firebase-admin can verify logins.
# On App Hosting this is NOT needed (it uses the built-in service account).
# GOOGLE_APPLICATION_CREDENTIALS="./service-account.json"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
